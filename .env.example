# AutoClip AI Configuration

# 1. AI Intelligence & Transcription (Google Gemini API)
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Whisper fallback)
OPENAI_API_KEY=

# 2. FFmpeg & FFprobe Binary Paths
# (Auto-detected if left empty; defaults to system PATH or C:\Program Files\kdenlive\bin\ffmpeg.exe)
FFMPEG_PATH=
FFPROBE_PATH=

# 3. Database Connection
DATABASE_URL=sqlite:///./autoclip.db

# Docker Compose local PostgreSQL password (replace with a strong random value)
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# 4. Storage Limits
MAX_UPLOAD_SIZE_MB=1000

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8000

# Authentication signing key: generate a unique random value of 32+ characters
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=60

# AWS region and private storage/queue resources (leave blank for local-only development)
AWS_REGION=ap-south-1
S3_BUCKET=
SQS_QUEUE_URL=
