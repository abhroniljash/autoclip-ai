# AutoClip AI Configuration

# 1. AI Intelligence & Transcription (Google Gemini API)
# Get your Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Whisper fallback)
OPENAI_API_KEY=

# 2. FFmpeg & FFprobe Binary Paths
# (Auto-detected if left empty; defaults to system PATH or C:\Program Files\kdenlive\bin\ffmpeg.exe)
FFMPEG_PATH=
FFPROBE_PATH=

# 3. Database Connection
DATABASE_URL=sqlite:///./autoclip.db

# 4. Storage Limits
MAX_UPLOAD_SIZE_MB=1000
